{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Flowtastic Documentation",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["index", "quickstart", "development"]
          },
          {
            "group": "Examples",
            "pages": [
              "api/github-actions-converter",
              "api/block-to-workflow",
              "api/validator"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Converters & Importers",
            "pages": ["api/yaml-importer", "api/templates", "api/blocks"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Repository",
          "href": "https://github.com/NelakaWith/flowtastic",
          "icon": "book-open-cover"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hi@flowtastic.dev"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open App",
      "href": "https://example.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/flowtastic",
      "github": "https://github.com/NelakaWith/flowtastic",
      "linkedin": "https://linkedin.com/company/flowtastic"
    }
  }
}
